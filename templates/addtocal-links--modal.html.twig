{%
set classes = [
  'btn-group',
  'dropend'
]
%}
<div{{attributes.addClass(classes)}}>
    <button type="btn btn-outline-secondary btn-sm" title="Add this event to your callendar. Select the corresponding callendar platform." class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      {{ label }}
    </button>
    <ul class="dropdown-menu">
      <li><a href="{{ google }}" alt="Add this event to Google callendar" title="Add this event to Google callendar" target="_blank" class="addtocal__link addtocal__google">Google</a></li>
      <li><a href="{{ outlook }}" alt="Add this event to Outlook callendar" title="Add this event to Outlook callendar" download="event.ics" class="addtocal__link addtocal__outlook">Outlook</a></li>
      <li><a href="{{ ical }}" alt="Add this event to Apple iCal" title="Add this event to Apple iCal" download="event.ics" class="addtocal__link addtocal__ical">iCal</a></li>
    </ul>
</div>