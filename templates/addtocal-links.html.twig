{%
set classes = [
  'add-to-calendar'
]
%}
{% if icons %}{{ attach_library('addtocal_augment/icons') }}{% endif %}
<span{{attributes.addClass(classes)}}>
    {% if label %}
        <label title="Add this event to your callendar. Click the icon on the right corresponding to your callendar platform." class="addtocal__label">{{ label }}:</label>
    {% endif %}
    <a href="{{ google }}" alt="Add this event to Google callendar" title="Add this event to Google callendar" target="_blank" class="addtocal__link addtocal__google">Google</a>
    <a href="{{ outlook }}" alt="Add this event to Outlook callendar" title="Add this event to Outlook callendar" download="event.ics" class="addtocal__link addtocal__outlook">Outlook</a>
    <a href="{{ ical }}" alt="Add this event to Apple iCal" title="Add this event to Apple iCal" download="event.ics" class="addtocal__link addtocal__ical">iCal</a>
</span>
